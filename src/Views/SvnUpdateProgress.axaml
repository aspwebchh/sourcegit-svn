<v:ChromelessWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:m="using:SourceGit.Models"
                    xmlns:vm="using:SourceGit.ViewModels"
                    xmlns:v="using:SourceGit.Views"
                    xmlns:c="using:SourceGit.Converters"
                    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
                    x:Class="SourceGit.Views.SvnUpdateProgress"
                    x:DataType="vm:SvnUpdateProgress"
                    x:Name="ThisControl"
                    Icon="/App.ico"
                    Title="{DynamicResource Text.Svn.UpdateProgress.Title}"
                    Width="800" Height="500"
                    MinWidth="480" MinHeight="360"
                    CanResize="True"
                    WindowStartupLocation="CenterOwner">
  <v:ChromelessWindow.Styles>
    <Style Selector="TextBlock.message">
      <Setter Property="Foreground" Value="{DynamicResource Brush.FG2}"/>
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="Red"/>
    </Style>
  </v:ChromelessWindow.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- TitleBar -->
    <Grid Grid.Row="0" Height="28" IsVisible="{Binding !#ThisControl.UseSystemWindowFrame}">
      <Border Background="{DynamicResource Brush.TitleBar}"
              BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}"
              PointerPressed="BeginMoveWindow"/>

      <Path Width="14" Height="14"
            Margin="10,0,0,0"
            HorizontalAlignment="Left"
            Data="{StaticResource Icons.Pull}"
            IsVisible="{OnPlatform True, macOS=False}"/>

      <TextBlock Classes="bold"
                 Text="{DynamicResource Text.Svn.UpdateProgress.Title}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False"/>

      <v:CaptionButtons HorizontalAlignment="Right"
                        IsCloseButtonOnly="True"
                        IsVisible="{OnPlatform True, macOS=False}"/>
    </Grid>

    <!-- Target -->
    <Border Grid.Row="1"
            Margin="12,12,12,0" Padding="12,8"
            Background="{DynamicResource Brush.SubPanel}"
            BorderThickness="1" BorderBrush="{DynamicResource Brush.Border2}"
            CornerRadius="6">
      <Grid ColumnDefinitions="Auto,*" Height="26">
        <TextBlock Grid.Column="0"
                   Margin="0,0,12,0"
                   Foreground="{DynamicResource Brush.FG2}"
                   Text="{DynamicResource Text.Svn.Update.Url}"/>
        <TextBlock Grid.Column="1"
                   HorizontalAlignment="Stretch"
                   Text="{Binding Url}"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding Url}"/>
      </Grid>
    </Border>

    <!-- Updated items -->
    <Grid Grid.Row="2" Margin="12,12,12,0" RowDefinitions="30,*" MinHeight="0">
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
        <Path Grid.Column="0" Width="14" Height="14"
              Margin="0,0,6,0"
              Fill="{DynamicResource Brush.FG2}"
              Data="{StaticResource Icons.Changes}"/>
        <TextBlock Grid.Column="1" Classes="bold"
                   Foreground="{DynamicResource Brush.FG2}"
                   Text="{DynamicResource Text.Svn.UpdateProgress.Activity}"/>
      </Grid>

      <Border Grid.Row="1"
              Background="{DynamicResource Brush.Contents}"
              BorderThickness="1" BorderBrush="{DynamicResource Brush.Border2}"
              CornerRadius="6" ClipToBounds="True">
        <ListBox x:Name="EntriesList"
                 Classes="repo_left_content_list"
                 Padding="0,2"
                 Background="{DynamicResource Brush.Contents}"
                 ItemsSource="{Binding Entries}"
                 SelectionMode="Single"
                 KeyDown="OnEntriesKeyDown">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Margin" Value="0"/>
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Height" Value="28"/>
            </Style>
          </ListBox.Styles>

          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel Orientation="Vertical"/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>

          <ListBox.ItemTemplate>
            <DataTemplate DataType="m:SvnUpdateEntry">
              <Grid Background="Transparent" ContextRequested="OnEntryContextRequested">
                <Grid ColumnDefinitions="4,88,*"
                      Margin="12,0,8,0"
                      IsVisible="{Binding IsFile}">
                  <Border Grid.Column="0"
                          Width="3" Height="14"
                          VerticalAlignment="Center"
                          CornerRadius="2"
                          Background="{Binding Action, Converter={x:Static c:SvnUpdateActionConverters.ToBrush}}"/>
                  <TextBlock Grid.Column="1"
                             Margin="8,0,0,0"
                             Foreground="{DynamicResource Brush.FG2}"
                             Text="{Binding Action, Converter={x:Static c:SvnUpdateActionConverters.ToName}}"
                             TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="2"
                             HorizontalAlignment="Stretch"
                             FontFamily="{DynamicResource Fonts.Monospace}"
                             Text="{Binding Path}"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Path}"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*"
                      Margin="12,0,8,0"
                      IsVisible="{Binding !IsFile}">
                  <Path Grid.Column="0"
                        Width="14" Height="14"
                        Margin="0,0,6,0"
                        Fill="Red"
                        Data="{StaticResource Icons.Error}"
                        IsVisible="{Binding IsError}"/>
                  <TextBlock Grid.Column="1"
                             HorizontalAlignment="Stretch"
                             Margin="6,0,0,0"
                             Text="{Binding Path}"
                             TextTrimming="CharacterEllipsis"
                             Classes.message="{Binding !IsError}"
                             Classes.error="{Binding IsError}"
                             ToolTip.Tip="{Binding Path}"/>
                </Grid>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Grid>

    <!-- Status and actions -->
    <Border Grid.Row="3"
            Margin="0,12,0,0"
            Background="{DynamicResource Brush.SubPanel}"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource Brush.Border0}">
      <Grid Margin="12,10" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
        <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="Auto,*">
          <Grid Grid.Column="0" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Top">
            <v:LoadingIcon Width="14" Height="14" IsVisible="{Binding IsRunning}"/>
            <Path Width="14" Height="14" Data="{StaticResource Icons.Check}"
                  Fill="LimeGreen" IsVisible="{Binding IsSucceeded}"/>
            <Path Width="14" Height="14" Data="{StaticResource Icons.Error}"
                  Fill="Red" IsVisible="{Binding IsFailed}"/>
            <Path Width="14" Height="14" Data="{StaticResource Icons.Info}"
                  Fill="{DynamicResource Brush.FG2}" IsVisible="{Binding IsCanceled}"/>
          </Grid>

          <TextBlock Grid.Column="1"
                     HorizontalAlignment="Stretch" VerticalAlignment="Top"
                     Text="{Binding StatusMessage}"
                     TextWrapping="Wrap"
                     Classes.error="{Binding IsFailed}"
                     ToolTip.Tip="{Binding StatusMessage}"/>
        </Grid>

        <TextBlock Grid.Row="1" Grid.Column="0"
                   Margin="20,4,0,0"
                   HorizontalAlignment="Stretch"
                   Classes="small message"
                   Text="{Binding Summary}"
                   TextWrapping="Wrap"/>

        <Grid Grid.Row="2" Grid.Column="0"
              Margin="20,4,0,0"
              ColumnDefinitions="Auto,*"
              IsVisible="{Binding HasConflicts}">
          <Path Grid.Column="0" Width="12" Height="12"
                Margin="0,2,6,0" VerticalAlignment="Top"
                Data="{StaticResource Icons.Error}" Fill="OrangeRed"/>
          <TextBlock Grid.Column="1"
                     HorizontalAlignment="Stretch"
                     Foreground="OrangeRed"
                     Text="{DynamicResource Text.Svn.UpdateProgress.Conflicts}"
                     TextWrapping="Wrap"/>
        </Grid>

        <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                Classes="flat"
                Width="100" Height="30"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Content="{DynamicResource Text.Cancel}"
                Click="OnCancelClicked"
                IsEnabled="{Binding !IsCanceling}"
                IsVisible="{Binding IsRunning}"/>

        <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                Classes="flat primary"
                Width="100" Height="30"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Content="{DynamicResource Text.Close}"
                Click="OnCloseClicked"
                IsVisible="{Binding !IsRunning}"/>
      </Grid>
    </Border>
  </Grid>
</v:ChromelessWindow>
