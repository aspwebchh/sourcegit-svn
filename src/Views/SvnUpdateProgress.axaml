<v:ChromelessWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:m="using:SourceGit.Models"
                    xmlns:vm="using:SourceGit.ViewModels"
                    xmlns:v="using:SourceGit.Views"
                    xmlns:c="using:SourceGit.Converters"
                    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
                    x:Class="SourceGit.Views.SvnUpdateProgress"
                    x:DataType="vm:SvnUpdateProgress"
                    x:Name="ThisControl"
                    Icon="/App.ico"
                    Title="{DynamicResource Text.Svn.UpdateProgress.Title}"
                    Width="800" Height="500"
                    MinWidth="480" MinHeight="300"
                    CanResize="True"
                    WindowStartupLocation="CenterOwner">
  <v:ChromelessWindow.Styles>
    <Style Selector="TextBlock.message">
      <Setter Property="Foreground" Value="{DynamicResource Brush.FG2}"/>
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="Red"/>
    </Style>
  </v:ChromelessWindow.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- TitleBar -->
    <Grid Grid.Row="0" Height="28" IsVisible="{Binding !#ThisControl.UseSystemWindowFrame}">
      <Border Background="{DynamicResource Brush.TitleBar}"
              BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}"
              PointerPressed="BeginMoveWindow"/>

      <Path Width="14" Height="14"
            Margin="10,0,0,0"
            HorizontalAlignment="Left"
            Data="{StaticResource Icons.Pull}"
            IsVisible="{OnPlatform True, macOS=False}"/>

      <TextBlock Classes="bold"
                 Text="{DynamicResource Text.Svn.UpdateProgress.Title}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False"/>

      <v:CaptionButtons HorizontalAlignment="Right"
                        IsCloseButtonOnly="True"
                        IsVisible="{OnPlatform True, macOS=False}"/>
    </Grid>

    <!-- Target -->
    <Grid Grid.Row="1" Margin="12,8,12,0" RowDefinitions="24,24" ColumnDefinitions="Auto,*">
      <TextBlock Grid.Row="0" Grid.Column="0"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,0,8,0"
                 Text="{DynamicResource Text.Svn.Update.Url}"/>
      <TextBlock Grid.Row="0" Grid.Column="1"
                 VerticalAlignment="Center"
                 Text="{Binding Url}"
                 TextTrimming="CharacterEllipsis"
                 ToolTip.Tip="{Binding Url}"/>

      <TextBlock Grid.Row="1" Grid.Column="0"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,0,8,0"
                 Text="{DynamicResource Text.Svn.Update.Revision}"/>
      <TextBlock Grid.Row="1" Grid.Column="1"
                 VerticalAlignment="Center"
                 FontFamily="{DynamicResource Fonts.Monospace}"
                 Text="{Binding TargetRevisionName}"/>
    </Grid>

    <!-- Updated Items -->
    <ListBox Grid.Row="2"
             x:Name="EntriesList"
             Margin="8,8,8,0"
             Padding="0,2"
             Background="{DynamicResource Brush.Contents}"
             BorderThickness="1"
             BorderBrush="{DynamicResource Brush.Border2}"
             ItemsSource="{Binding Entries}"
             SelectionMode="Single"
             KeyDown="OnEntriesKeyDown"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Margin" Value="0"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Height" Value="24"/>
        </Style>
      </ListBox.Styles>

      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel Orientation="Vertical"/>
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>

      <ListBox.ItemTemplate>
        <DataTemplate DataType="m:SvnUpdateEntry">
          <Grid ColumnDefinitions="Auto,*" Background="Transparent" ContextRequested="OnEntryContextRequested">
            <TextBlock Grid.Column="0"
                       Width="80"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Classes="bold"
                       Text="{Binding Action, Converter={x:Static c:SvnUpdateActionConverters.ToName}}"
                       Foreground="{Binding Action, Converter={x:Static c:SvnUpdateActionConverters.ToBrush}}"
                       IsVisible="{Binding IsFile}"/>

            <TextBlock Grid.Column="1"
                       Margin="8,0"
                       VerticalAlignment="Center"
                       FontFamily="{DynamicResource Fonts.Monospace}"
                       Text="{Binding Path}"
                       TextTrimming="CharacterEllipsis"
                       Classes.message="{Binding !IsFile}"
                       Classes.error="{Binding IsError}"
                       ToolTip.Tip="{Binding Path}"/>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Status and Buttons -->
    <Grid Grid.Row="3" Margin="12,8,8,8" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
      <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="Auto,*">
        <Grid Grid.Column="0" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
          <v:LoadingIcon Width="14" Height="14" IsVisible="{Binding IsRunning}"/>
          <Path Width="14" Height="14" Data="{StaticResource Icons.Check}" Fill="LimeGreen">
            <Path.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="!IsRunning"/>
                <Binding Path="!IsFailed"/>
              </MultiBinding>
            </Path.IsVisible>
          </Path>
          <Path Width="14" Height="14" Data="{StaticResource Icons.Error}" Fill="Red">
            <Path.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="!IsRunning"/>
                <Binding Path="IsFailed"/>
              </MultiBinding>
            </Path.IsVisible>
          </Path>
        </Grid>

        <TextBlock Grid.Column="1"
                   VerticalAlignment="Center"
                   Text="{Binding StatusMessage}"
                   TextTrimming="CharacterEllipsis"
                   Classes.error="{Binding IsFailed}"
                   ToolTip.Tip="{Binding StatusMessage}"/>
      </Grid>

      <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="20,4,0,0">
        <TextBlock Classes="small message" Text="{Binding Summary}"/>
        <TextBlock Classes="small"
                   Margin="16,0,0,0"
                   Foreground="OrangeRed"
                   Text="{DynamicResource Text.Svn.UpdateProgress.Conflicts}"
                   IsVisible="{Binding HasConflicts}"/>
      </StackPanel>

      <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
              Classes="flat"
              Width="100" Height="30"
              Margin="8,0,0,0"
              VerticalAlignment="Center"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              Content="{DynamicResource Text.Cancel}"
              Click="OnCancelClicked"
              IsVisible="{Binding IsRunning}"/>

      <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
              Classes="flat primary"
              Width="100" Height="30"
              Margin="8,0,0,0"
              VerticalAlignment="Center"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              Content="{DynamicResource Text.Close}"
              Click="OnCloseClicked"
              IsVisible="{Binding !IsRunning}"/>
    </Grid>
  </Grid>
</v:ChromelessWindow>
